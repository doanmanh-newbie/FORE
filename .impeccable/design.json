  "narrative": {
    "northStar": "The Clean Bar",
    "overview": "Fore trông như mặt quầy pha chế vừa lau xong: bề mặt sáng, mọi dụng cụ đặt đúng chỗ, không có thứ gì thừa trên quầy. Người dùng mở app giữa lúc phục vụ khách hoặc khi đang ở xa quán, nên giao diện phải đọc được trong một cái liếc và bấm được bằng một tay. Biểu cảm thương hiệu nằm ở chi tiết chính xác (chữ có chân cho tiêu đề và con số, màu mực xanh đậm), không nằm ở trang trí.\n\nHệ thống tinh gọn và tiết chế. Bề mặt phẳng, phân lớp bằng sắc độ nền và viền mảnh thay vì bóng đổ. Màu trạng thái (xanh, vàng, đỏ) chỉ xuất hiện khi có điều cần chú ý, để một ca lệch nổi lên rõ ràng trên nền yên tĩnh. Mật độ vừa phải: thẻ có khoảng thở 16 px, nhưng danh sách thao tác trong ca được xếp chặt để nhân viên thấy nhiều hơn mà không cuộn.\n\nCả bộ `core/design/` lẫn bộ `Fore*` trong `core/widgets/` đều phẳng: không thành phần nào còn bóng đổ.",
    "keyCharacteristics": [
      "Nền xanh xám rất nhạt, thẻ trắng viền mảnh, không bóng.",
      "Tiêu đề, số KPI bằng chữ có chân Newsreader; nội dung, nhãn, nút bằng Inter.",
      "Một màu hành động chính (mực xanh đậm), màu lime chỉ dành cho thẻ nổi bật nền tối.",
      "Màu trạng thái là tín hiệu, không phải trang trí.",
      "Vùng chạm tối thiểu 48 dp; chuyển động tôn trọng \"giảm chuyển động\" của thiết bị."
    ],
    "rules": [
      {
        "name": "The On-Ink Rule",
        "body": "Chữ hoặc icon đặt trên nền mực luôn dùng `AppColors.onInk`, không dùng `Colors.white`; trắng cố định chỉ dành cho thẻ nền Night Shift.",
        "section": "colors"
      },
      {
        "name": "The Signal-Only Rule",
        "body": "Xanh, vàng, đỏ trạng thái chỉ xuất hiện khi dữ liệu thật sự ở trạng thái đó. Không dùng chúng để trang trí, phân nhóm hay làm màu thương hiệu.",
        "section": "colors"
      },
      {
        "name": "The One Ink Rule",
        "body": "Mỗi màn chỉ có một hành động chính tô màu mực xanh đậm; các hành động khác dùng viền hoặc chữ.",
        "section": "colors"
      },
      {
        "name": "The Serif-for-Numbers Rule",
        "body": "Con số quyết định (tiền ca, chênh lệch, KPI) dùng Newsreader với số đều độ rộng; con số trong danh sách và bảng dùng Inter số đều độ rộng.",
        "section": "typography"
      },
      {
        "name": "The Role-not-Size Rule",
        "body": "Màn hình dùng vai trò trong `AppTextStyles`, không tự đặt `fontSize`. Thang `AppFontSizes` chỉ dành cho thành phần nền.",
        "section": "typography"
      },
      {
        "name": "The Wiped-Counter Rule",
        "body": "Bề mặt phẳng khi đứng yên. Không thêm bóng đổ cho thẻ, nút hay thanh điều hướng mới; dùng viền mảnh hoặc đổi sắc độ nền.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** lấy mọi màu, cỡ chữ, khoảng cách từ `lib/core/design/` (`AppColors`, `AppTextStyles`, `AppSizes`).",
      "**Do** giữ vùng chạm tối thiểu 48×48 dp, kể cả khi phần nhìn thấy nhỏ hơn.",
      "**Do** dùng `Motion.of(context, ...)` cho mọi thời lượng chuyển động.",
      "**Do** dùng Text Secondary (#4F6663) cho chữ phụ và Warning Text (#B54708) cho chữ cảnh báo.",
      "**Do** dùng thành phần trong `core/design/` cho màn mới; chuyển màn cũ khi sửa tới."
    ],
    "donts": [
      "**Don't** thêm bóng đổ cho thẻ, nút hoặc thanh điều hướng mới.",
      "**Don't** viết mã màu thô (`Color(0x...)`) hay `Colors.*` ngoài `lib/core/design/`.",
      "**Don't** dùng Counter Teal (#51A19B) hay `warning` (#ED6C02) cho chữ: đều dưới 4,5:1 ở chế độ sáng.",
      "**Don't** dùng `Colors.white` trên nền mực; dùng `AppColors.onInk` để đúng ở cả hai chế độ.",
      "**Don't** dùng Lime Pour trên nền sáng hoặc cho hành động phụ.",
      "**Don't** dùng màu trạng thái cho mục đích trang trí.",
      "**Don't** tạo thêm token \"legacy\" mới.",
      "**Don't** dùng `ListView(children: ...)` cho danh sách theo dữ liệu; dùng `LazyListView`."
    ]
  }
}